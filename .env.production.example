# The shape of the secret stored in Secret Manager as `rooms-env`, which
# infra/startup.sh downloads to /opt/rooms/.env on every machine.

# DOMAIN and PUBLIC_URL are deliberately absent: they differ per machine, so
# they travel as instance metadata and are appended by infra/startup.sh. This
# file holds only what every machine shares.

# Database — never exposed outside the compose network.
POSTGRES_DB=rooms
POSTGRES_USER=rooms
POSTGRES_PASSWORD=

# Auth. Generate each with: openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=

# Snake game
SNAKE_TICK_MS=150

# OAuth — optional, leave empty to disable. Register the callback URLs below in
# each provider's console as <PUBLIC_URL>/api/auth/<provider>-redirect
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
