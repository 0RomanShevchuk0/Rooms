# Copy to .env.production on the server and fill in real values.
# Used by: docker compose -f docker-compose.prod.yml --env-file .env.production ...

# Site address Caddy serves. Use ":80" for plain HTTP while testing on a raw IP,
# then switch to the bare domain (e.g. rooms.example.com) to get automatic HTTPS.
DOMAIN=:80

# Public origin of the app, used for CORS, OAuth redirects and callback URLs.
# Must match how the browser reaches the site: http://<server-ip> or https://<domain>
PUBLIC_URL=http://localhost

# Database — never exposed outside the compose network.
POSTGRES_DB=rooms
POSTGRES_USER=rooms
POSTGRES_PASSWORD=

# Auth. Generate each with: openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=

# Snake game
SNAKE_TICK_MS=150

# OAuth — optional, leave empty to disable. Register the callback URLs below in
# each provider's console as <PUBLIC_URL>/api/auth/<provider>-redirect
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
