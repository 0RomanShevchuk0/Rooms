# Runtime
NODE_ENV=development
PORT=4000

# Comma-separated list of origins allowed to call the API with credentials
ALLOWED_ORIGINS=http://localhost:3000
# Base URL of the web app, used for OAuth redirects back to the client
CLIENT_URL=http://localhost:3000

# Auth
JWT_SECRET=
JWT_REFRESH_SECRET=

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/rooms

# Snake game
SNAKE_TICK_MS=150

# OAuth callbacks carry a state cookie scoped to /api/auth, so the callback URLs
# below must sit on the same site the flow starts from. In production point them
# at the web origin (e.g. https://app.example.com/api/auth/google-redirect) so
# the Next.js /api/* rewrite proxies them to this service.

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google-redirect

# Discord OAuth (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:4000/api/auth/discord-redirect
