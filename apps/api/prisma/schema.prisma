// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
   provider     = "prisma-client"
   output       = "../generated/prisma"
   moduleFormat = "cjs"
}

datasource db {
   provider = "postgresql"
}

enum OAuthProvider {
   google
   discord
}

model User {
   id            String         @id @default(uuid())
   email         String?        @unique
   name          String?
   username      String         @unique
   password      String?
   deletedAt     DateTime?
   oauthProvider OAuthProvider?
   oauthId       String?

   participants RoomParticipant[] @relation("UserParticipants")

   messages Message[] @relation("MessageSender")

   createdAt DateTime @default(now())

   @@unique([oauthProvider, oauthId])
}

model Room {
   id          String  @id @default(uuid())
   name        String
   description String?

   participants RoomParticipant[] @relation("RoomParticipants")

   chat          Chat?              @relation("RoomChat")
   snakeSettings RoomSnakeSettings?

   createdAt DateTime @default(now())
}

model RoomSnakeSettings {
   roomId String @id

   fieldWidth  Int @default(20)
   fieldHeight Int @default(20)
   foodAmount  Int @default(1)

   room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

   createdAt DateTime @default(now())
   updatedAt DateTime @updatedAt
}

model RoomParticipant {
   id      String  @id @default(uuid())
   isReady Boolean @default(false)

   userId String
   user   User   @relation("UserParticipants", fields: [userId], references: [id])

   roomId String
   room   Room   @relation("RoomParticipants", fields: [roomId], references: [id], onDelete: Cascade)

   createdAt DateTime @default(now())

   @@unique([roomId, userId])
   @@index([roomId])
   @@index([userId])
}

model Chat {
   id String @id @default(uuid())

   roomId String @unique
   room   Room   @relation("RoomChat", fields: [roomId], references: [id], onDelete: Cascade)

   messages Message[] @relation("ChatMessages")

   createdAt DateTime @default(now())
}

model Message {
   id      String @id @default(uuid())
   content String

   chatId String
   chat   Chat   @relation("ChatMessages", fields: [chatId], references: [id], onDelete: Cascade)

   senderId String
   sender   User   @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)

   createdAt DateTime @default(now())
}
